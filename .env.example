# VoiceNote Environment Variables Reference
# Copy this file to '.env' and fill in your configuration values.

# ----------------------------------------------------
# 🔑 AI & STT API Keys
# ----------------------------------------------------
# Gemini API Key for transcript analysis, task extraction & summaries
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key for fast cloud Whisper speech-to-text
GROQ_API_KEY=your_groq_api_key_here

# ----------------------------------------------------
# 🗄️ PostgreSQL Database Configuration
# ----------------------------------------------------
DB_ENGINE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voicenote
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
